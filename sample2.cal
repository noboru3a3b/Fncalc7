## callcc -> return 化
def member_tree(x, tree)
  let iter = 0 in
    iter = fn(tree)
      let i = 0,
          k = length(tree) in
        while i < k do
          if vector(tree[i]) then
            if (iter(tree[i]) == 1) then return 1; end
          else
            if tree[i] == x then return 1; end
          end
          i = i + 1;
        end
      end
    end;
    iter(tree);
  end
end

# 葉の個数を求める
def count_leaf(v)
  let c = 0,
      i = 0,
      k = length(v) in
    while i < k do
      if vector(v[i]) then
        c = c + count_leaf(v[i]);
      else
        c = c + 1;
      end
      i = i + 1;
    end
    c;
  end
end

# 平坦化（begin ... end 削除した）
def flatten(v)
  let i = 0,
      iter = 0,
      flat = make_vector(count_leaf(v), 0) in
    iter = fn(v)
      let j = 0,
          k = length(v) in
        while j < k do
          if vector(v[j]) then
            iter(v[j]);
          else
            flat[i] = v[j];
            i = i + 1;
          end
          j = j + 1;
        end
      end
    end;
    iter(v);
    flat;
  end
end

